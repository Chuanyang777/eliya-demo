<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Eliya – Winter Night Companion</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    :root {
      --night: #0b1b33;
      --cream: #fff7ec;
      --mint: #a6e3c3;
      --cocoa: #b77946;
      --text-main: #202124;
      --text-muted: #6b7280;
      --border-soft: #e5e7eb;
      --card: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        sans-serif;
    }

    body {
      background: radial-gradient(circle at top, #1f2937 0, #020617 55%);
      color: var(--cream);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .page {
      max-width: 1120px;
      margin: 0 auto;
      padding: 22px 16px 40px;
    }

    /* Header */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
    }

    .logo-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-icon {
      width: 42px;
      height: 42px;
      border-radius: 18px;
      background: radial-gradient(circle at 30% 30%, #ffffff, #a6e3c3);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.5);
    }

    .logo-icon::before {
      content: "";
      position: absolute;
      width: 22px;
      height: 10px;
      border-radius: 999px;
      border: 2px solid rgba(15, 23, 42, 0.4);
      top: 6px;
    }

    .logo-icon::after {
      content: "";
      position: absolute;
      width: 22px;
      height: 8px;
      border-radius: 999px;
      border: 2px solid rgba(15, 23, 42, 0.4);
      top: 12px;
    }

    .logo-title {
      font-weight: 700;
      font-size: 1.4rem;
      letter-spacing: 0.04em;
    }

    .logo-sub {
      font-size: 0.8rem;
      color: #e5e7eb;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 0.9rem;
      color: #cbd5f5;
    }

    nav a:hover {
      color: var(--mint);
    }

    /* Hero */
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 26px;
      align-items: center;
      margin-bottom: 30px;
    }

    .hero-text h1 {
      font-size: clamp(2.1rem, 3vw, 2.6rem);
      margin-bottom: 8px;
    }

    .hero-text p {
      font-size: 0.96rem;
      color: #e5e7eb;
      max-width: 520px;
      margin-bottom: 10px;
    }

    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }

    .badge {
      font-size: 0.78rem;
      padding: 4px 9px;
      border-radius: 999px;
      background: rgba(166, 227, 195, 0.12);
      border: 1px solid rgba(166, 227, 195, 0.7);
      color: #bbf7d0;
    }

    .hero-downloads {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 10px;
    }

    .store-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 13px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.9);
      background: rgba(15, 23, 42, 0.9);
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.7);
      font-size: 0.88rem;
      cursor: pointer;
      transition: transform 0.1s ease, box-shadow 0.1s ease;
      color: #e5e7eb;
    }

    .store-btn span:first-child {
      font-size: 1.05rem;
    }

    .store-btn small {
      display: block;
      font-size: 0.7rem;
      color: #9ca3af;
    }

    .store-btn strong {
      font-weight: 600;
    }

    .store-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 28px rgba(15, 23, 42, 0.9);
    }

    .hero-note {
      font-size: 0.78rem;
      color: #9ca3af;
    }

    /* Hero visual */
    .hero-visual {
      display: flex;
      justify-content: center;
    }

    .device-card {
      background: radial-gradient(circle at top, #1e293b 0, #020617 70%);
      border-radius: 24px;
      padding: 18px 18px 20px;
      box-shadow: 0 22px 45px rgba(15, 23, 42, 0.9);
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 14px;
      align-items: center;
    }

    /* Bear front */
    .bear-wrap {
      text-align: center;
    }

    .bear-chain {
      width: 26px;
      height: 40px;
      margin: 0 auto -8px;
      position: relative;
    }

    .bear-chain::before {
      content: "";
      position: absolute;
      width: 18px;
      height: 18px;
      border-radius: 999px;
      border: 3px solid #facc15;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
    }

    .bear-chain::after {
      content: "";
      position: absolute;
      width: 3px;
      height: 20px;
      background: #facc15;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
    }

    .bear {
      width: 120px;
      height: 150px;
      background: var(--cocoa);
      border-radius: 40px;
      margin: 0 auto;
      position: relative;
      box-shadow: 0 10px 22px rgba(15, 23, 42, 0.8);
    }

    .bear::before,
    .bear::after {
      content: "";
      position: absolute;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--cocoa);
      top: -20px;
      box-shadow: 0 4px 10px rgba(15, 23, 42, 0.6);
    }

    .bear::before {
      left: 10px;
    }

    .bear::after {
      right: 10px;
    }

    .bear-face {
      position: absolute;
      top: 34px;
      left: 50%;
      transform: translateX(-50%);
      width: 56px;
      text-align: center;
    }

    .eye {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: #111827;
      display: inline-block;
      margin: 0 6px;
    }

    .nose {
      width: 12px;
      height: 9px;
      background: #111827;
      border-radius: 999px;
      margin: 4px auto 0;
      position: relative;
    }

    .nose::after {
      content: "";
      position: absolute;
      width: 14px;
      height: 10px;
      border-bottom: 2px solid #111827;
      border-radius: 0 0 16px 16px;
      left: 50%;
      transform: translateX(-50%);
      top: 7px;
    }

    .bear-belly {
      position: absolute;
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%);
      width: 52px;
      height: 52px;
      border-radius: 999px;
      background: radial-gradient(circle at 30% 30%, #fefce8, #fde68a);
      box-shadow: 0 0 0 2px rgba(15, 23, 42, 0.2);
    }

    .bear-feet {
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 8px;
    }

    .foot {
      width: 30px;
      height: 14px;
      border-radius: 999px;
      background: #f9fafb;
      box-shadow: 0 4px 6px rgba(15, 23, 42, 0.7);
    }

    /* Kubotan */
    .kubotan {
      position: absolute;
      right: -28px;
      bottom: 20px;
      width: 38px;
      height: 90px;
      background: linear-gradient(160deg, #facc15, #f97316);
      border-radius: 999px;
      box-shadow: 0 8px 18px rgba(251, 191, 36, 0.7);
      clip-path: polygon(50% 0, 70% 20%, 50% 40%, 70% 60%, 50% 80%, 50% 100%, 30% 80%, 50% 60%, 30% 40%, 50% 20%);
    }

    .bear-caption {
      font-size: 0.72rem;
      color: #cbd5f5;
      margin-top: 6px;
      max-width: 160px;
      margin-inline: auto;
    }

    /* Phone mock */
    .phone {
      width: 210px;
      height: 380px;
      border-radius: 26px;
      background: #020617;
      padding: 8px;
      margin: 0 auto;
      box-shadow: 0 18px 36px rgba(0, 0, 0, 0.9);
    }

    .phone-screen {
      width: 100%;
      height: 100%;
      border-radius: 20px;
      background: linear-gradient(to bottom, #0b1120, #020617);
      padding: 10px 12px 14px;
      position: relative;
      color: #e5e7eb;
      overflow: hidden;
    }

    .phone-notch {
      position: absolute;
      top: 6px;
      left: 50%;
      transform: translateX(-50%);
      width: 94px;
      height: 16px;
      border-radius: 999px;
      background: #020617;
    }

    .status-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.55rem;
      color: #9ca3af;
      margin-bottom: 10px;
      padding-top: 4px;
    }

    .map-card {
      border-radius: 16px;
      background: radial-gradient(circle at 35% 20%, #22d3ee 0, #1d4ed8 45%, #020617 100%);
      height: 130px;
      margin-bottom: 10px;
      position: relative;
      overflow: hidden;
    }

    .map-pin {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -55%);
      width: 30px;
      height: 40px;
      border-radius: 999px;
      background: #f97316;
      box-shadow: 0 8px 15px rgba(248, 113, 113, 0.8);
    }

    .map-pin::after {
      content: "";
      position: absolute;
      width: 16px;
      height: 16px;
      border-radius: 999px;
      background: #fefce8;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
    }

    .map-label {
      position: absolute;
      bottom: 6px;
      left: 12px;
      font-size: 0.7rem;
      color: #e5e7eb;
      background: rgba(15, 23, 42, 0.6);
      padding: 2px 6px;
      border-radius: 999px;
    }

    .app-title {
      font-size: 1.02rem;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .app-sub {
      font-size: 0.7rem;
      color: #9ca3af;
      margin-bottom: 8px;
    }

    .app-actions {
      display: flex;
      justify-content: space-between;
      gap: 6px;
      margin-bottom: 10px;
    }

    .app-bubble {
      flex: 1;
      border-radius: 999px;
      padding: 7px 0;
      text-align: center;
      font-size: 0.7rem;
      font-weight: 600;
      color: #0b1120;
      box-shadow: 0 5px 14px rgba(15, 23, 42, 0.7);
    }

    .app-bubble span {
      display: block;
      font-size: 0.58rem;
      font-weight: 400;
      color: #020617;
      opacity: 0.9;
    }

    .app-bubble.track {
      background: #38bdf8;
    }

    .app-bubble.sos {
      background: #fb7185;
    }

    .app-bubble.lamp {
      background: #facc15;
    }

    .app-bubble.mirror {
      background: #a5b4fc;
    }

    .find-btn {
      margin-top: 2px;
      border-radius: 999px;
      background: #e5f4ff;
      color: #0f172a;
      text-align: center;
      padding: 7px 0;
      font-size: 0.78rem;
      font-weight: 600;
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.9);
    }

    .find-btn span {
      font-size: 0.9rem;
      margin-right: 4px;
    }

    .helper-text {
      margin-top: 6px;
      font-size: 0.65rem;
      color: #9ca3af;
    }

    /* Sections */
    .section {
      margin-top: 26px;
      margin-bottom: 10px;
    }

    .section h2 {
      font-size: 1.28rem;
      margin-bottom: 4px;
      color: #e5e7eb;
    }

    .section p {
      font-size: 0.9rem;
      color: #cbd5f5;
      max-width: 540px;
    }

    /* Register */
    .register-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 20px;
      margin-top: 16px;
    }

    form {
      background: var(--card);
      border-radius: 18px;
      padding: 16px 16px 18px;
      border: 1px solid rgba(148, 163, 184, 0.9);
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.9);
      color: var(--text-main);
    }

    .form-row {
      margin-bottom: 10px;
    }

    label {
      font-size: 0.8rem;
      font-weight: 500;
      display: block;
      margin-bottom: 4px;
    }

    input {
      width: 100%;
      padding: 7px 9px;
      border-radius: 10px;
      border: 1px solid #d1d5db;
      font-size: 0.85rem;
      background: #f9fafb;
      outline: none;
      transition: border-color 0.12s, box-shadow 0.12s;
    }

    input:focus {
      border-color: #0ea5e9;
      box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.5);
      background: #ffffff;
    }

    .hint {
      font-size: 0.7rem;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .btn-main {
      margin-top: 4px;
      width: 100%;
      padding: 8px 10px;
      border-radius: 999px;
      border: none;
      background: linear-gradient(135deg, #38bdf8, #6366f1);
      color: #ffffff;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      box-shadow: 0 12px 28px rgba(37, 99, 235, 0.8);
      transition: transform 0.1s, box-shadow 0.1s;
    }

    .btn-main:hover {
      transform: translateY(-1px);
      box-shadow: 0 16px 34px rgba(37, 99, 235, 0.9);
    }

    .btn-main:active {
      transform: translateY(0);
      box-shadow: 0 10px 22px rgba(37, 99, 235, 0.8);
    }

    .register-note {
      font-size: 0.76rem;
      color: var(--text-muted);
      margin-top: 6px;
    }

    .register-side {
      font-size: 0.85rem;
      color: #cbd5f5;
    }

    .register-side strong {
      color: #facc15;
    }

    .pill-list {
      margin-top: 6px;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .pill {
      font-size: 0.76rem;
      padding: 4px 8px;
      border-radius: 999px;
      border: 1px dashed rgba(248, 250, 252, 0.6);
      background: rgba(15, 23, 42, 0.6);
    }

    /* Products */
    .products {
      margin-top: 26px;
    }

    .product-grid {
      margin-top: 14px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 16px;
    }

    .product-card {
      background: rgba(15, 23, 42, 0.9);
      border-radius: 18px;
      padding: 12px 12px 14px;
      border: 1px solid rgba(148, 163, 184, 0.8);
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.9);
    }

    .mini-bear {
      width: 74px;
      height: 94px;
      border-radius: 26px;
      margin: 0 auto 8px;
      position: relative;
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.9);
    }

    .mini-bear::before,
    .mini-bear::after {
      content: "";
      position: absolute;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      top: -14px;
      box-shadow: 0 4px 8px rgba(15, 23, 42, 0.8);
    }

    .mini-face {
      position: absolute;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: 34px;
      text-align: center;
    }

    .mini-face .eye {
      width: 4px;
      height: 4px;
      margin: 0 4px;
      background: #020617;
    }

    .mini-face .nose {
      width: 9px;
      height: 7px;
      background: #020617;
      margin: 3px auto 0;
      border-radius: 999px;
    }

    .mini-face .nose::after {
      content: "";
      position: absolute;
      width: 10px;
      height: 8px;
      border-bottom: 2px solid #020617;
      border-radius: 0 0 12px 12px;
      left: 50%;
      transform: translateX(-50%);
      top: 7px;
    }

    .mini-btn {
      position: absolute;
      bottom: 10px;
      left: 50%;
      transform: translateX(-50%);
      width: 30px;
      height: 30px;
      border-radius: 999px;
      background: rgba(248, 250, 252, 0.6);
      box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.7);
    }

    .product-name {
      font-size: 0.94rem;
      font-weight: 600;
      text-align: center;
      margin-bottom: 3px;
      color: #e5e7eb;
    }

    .product-meta {
      font-size: 0.78rem;
      color: #9ca3af;
      text-align: center;
      margin-bottom: 4px;
    }

    .product-tagline {
      font-size: 0.8rem;
      text-align: center;
      color: #bfdbfe;
      margin-bottom: 6px;
    }

    .product-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.78rem;
      color: #e5e7eb;
    }

    .price {
      font-weight: 600;
      color: #facc15;
    }

    .swatch {
      display: inline-block;
      width: 12px;
      height: 12px;
      border-radius: 999px;
      margin-right: 4px;
      border: 1px solid rgba(15, 23, 42, 0.8);
    }

    /* Footer */
    footer {
      margin-top: 30px;
      padding-top: 14px;
      border-top: 1px solid rgba(148, 163, 184, 0.7);
      font-size: 0.78rem;
      color: #9ca3af;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px;
    }

    footer a {
      color: #bfdbfe;
      font-weight: 500;
    }

    /* Responsive */
    @media (max-width: 820px) {
      header {
        flex-direction: column;
        align-items: flex-start;
      }

      .hero,
      .register-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .hero-visual {
        order: -1;
      }

      nav {
        justify-content: flex-start;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <header>
      <div class="logo-wrap">
        <div class="logo-icon"></div>
        <div>
          <div class="logo-title">Eliya</div>
          <div class="logo-sub">Winter Night Companion</div>
        </div>
      </div>
      <nav>
        <a href="#app">App</a>
        <a href="#register">Join with Code</a>
        <a href="#products">Colours</a>
      </nav>
    </header>

    <!-- Hero -->
    <section class="hero" id="app">
      <div class="hero-text">
        <h1>Winter walks, one tiny guardian.</h1>
        <p>
          Eliya is a bear-shaped keychain with a hidden mirror &amp; SOS button
          on the back, a mini lamp, tracking and a small self-defence tool –
          created to give UK students both practical safety and emotional
          comfort on winter nights.
        </p>
        <div class="hero-badges">
          <span class="badge">Tracking &amp; find device</span>
          <span class="badge">Mini lamp &amp; mirror</span>
          <span class="badge">Basic self-defence kubotan</span>
        </div>

        <div class="hero-downloads">
          <button class="store-btn">
            <span></span>
            <span>
              <small>Download on the</small>
              <strong>App&nbsp;Store</strong>
            </span>
          </button>
          <button class="store-btn">
            <span>▶︎</span>
            <span>
              <small>Get it on</small>
              <strong>Google&nbsp;Play</strong>
            </span>
          </button>
        </div>
        <div class="hero-note">
          *Concept demo – download buttons are placeholders for the student
          project.
        </div>
      </div>

      <!-- Product + app -->
      <div class="hero-visual">
        <div class="device-card">
          <div class="bear-wrap">
            <div class="bear-chain"></div>
            <div class="bear">
              <div class="bear-face">
                <span class="eye"></span>
                <span class="eye"></span>
                <div class="nose"></div>
              </div>
              <div class="bear-belly"></div>
              <div class="bear-feet">
                <div class="foot"></div>
                <div class="foot"></div>
              </div>
              <div class="kubotan"></div>
            </div>
            <p class="bear-caption">
              Front: plush bear + mini lamp &amp; kubotan.<br />
              Back: round mirror &amp; SOS button linked to the app.
            </p>
          </div>

          <div class="phone">
            <div class="phone-screen">
              <div class="phone-notch"></div>
              <div class="status-row">
                <span>9:41</span>
                <span>LTE 🔋</span>
              </div>
              <div class="map-card">
                <div class="map-pin"></div>
                <div class="map-label">Walking home – sharing live route</div>
              </div>
              <div class="app-title">Eliya App</div>
              <div class="app-sub">
                One tap on the bear’s back, instant protection in your phone.
              </div>
              <div class="app-actions">
                <div class="app-bubble track">
                  Tracking
                  <span>Real-time route for friends</span>
                </div>
                <div class="app-bubble sos">
                  SOS
                  <span>Hold 3s twice to alert</span>
                </div>
              </div>
              <div class="app-actions">
                <div class="app-bubble lamp">
                  Lamp
                  <span>Mini light for dark paths</span>
                </div>
                <div class="app-bubble mirror">
                  Mirror
                  <span>Check in before you walk</span>
                </div>
              </div>
              <div class="find-btn">
                <span>🔍</span> Find Eliya device
              </div>
              <div class="helper-text">
                If you’re anxious or lose your keys, the app can make Eliya
                flash and ring.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Registration -->
    <section class="section" id="register">
      <h2>Join with an Eliya Code</h2>
      <p>
        Use your unique <strong>Eliya Code</strong> to register as an early UK
        student tester. You’ll unlock beta access to the app and priority pricing
        on the bear charm.
      </p>

      <div class="register-grid">
        <form id="eliya-form">
          <div class="form-row">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" placeholder="Your name" />
          </div>

          <div class="form-row">
            <label for="email">University email</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="you@uni.ac.uk"
            />
            <div class="hint">
              Using a uni email helps us focus on students in the UK region.
            </div>
          </div>

          <div class="form-row">
            <label for="password">Create password</label>
            <input
              id="password"
              name="password"
              type="password"
              placeholder="At least 8 characters"
            />
          </div>

          <div class="form-row">
            <label for="code">Eliya Code</label>
            <input
              id="code"
              name="code"
              type="text"
              placeholder="e.g. WINTERNIGHT25"
            />
            <div class="hint">
              Codes are shared through campus ambassadors and our winter safety
              campaigns.
            </div>
          </div>

          <button type="submit" class="btn-main">Sign up with code</button>
          <div class="register-note">
            This is a demo form – in a real launch, your details would be stored
            securely and only used for Eliya updates.
          </div>
        </form>

        <div class="register-side">
          <p>
            With an <strong>Eliya Code</strong>, you can:
          </p>
          <ul>
            <li>Reserve your Winter Night Companion before public launch</li>
            <li>Access the tracking &amp; SOS app beta</li>
            <li>Help us improve safety features for students in the UK</li>
          </ul>

          <div class="pill-list">
            <span class="pill">Winter night bus walks</span>
            <span class="pill">Flatmate safety circles</span>
            <span class="pill">Gifts for friends &amp; partners</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Products / colours -->
    <section class="products" id="products">
      <h2>Choose your bear colour</h2>
      <p>
        The technology inside is the same – GPS, SOS, mini lamp and mirror – but
        each colour gives a different mood and emotional value.
      </p>

      <div class="product-grid">
        <!-- Cocoa Brown -->
        <div class="product-card">
          <div
            class="mini-bear"
            style="background:#b77946;"
          >
            <div
              style="position:absolute;width:26px;height:26px;border-radius:50%;background:#b77946;left:4px;top:-14px;"
            ></div>
            <div
              style="position:absolute;width:26px;height:26px;border-radius:50%;background:#b77946;right:4px;top:-14px;"
            ></div>
            <div class="mini-face">
              <span class="eye"></span><span class="eye"></span>
              <div class="nose"></div>
            </div>
            <div class="mini-btn"></div>
          </div>
          <div class="product-name">Cocoa Bear</div>
          <div class="product-meta">
            <span class="swatch" style="background:#b77946;"></span>
            Warm &amp; classic comfort
          </div>
          <div class="product-tagline">
            Feels like carrying a tiny plush friend in your pocket.
          </div>
          <div class="product-footer">
            <span class="price">From £29</span>
            <span>Best for everyday use</span>
          </div>
        </div>

        <!-- Midnight Blue -->
        <div class="product-card">
          <div
            class="mini-bear"
            style="background:#1f2937;"
          >
            <div
              style="position:absolute;width:26px;height:26px;border-radius:50%;background:#1f2937;left:4px;top:-14px;"
            ></div>
            <div
              style="position:absolute;width:26px;height:26px;border-radius:50%;background:#1f2937;right:4px;top:-14px;"
            ></div>
            <div class="mini-face">
              <span class="eye"></span><span class="eye"></span>
              <div class="nose"></div>
            </div>
            <div class="mini-btn"></div>
          </div>
          <div class="product-name">Midnight Blue</div>
          <div class="product-meta">
            <span class="swatch" style="background:#1f2937;"></span>
            Subtle, night-walk aesthetic
          </div>
          <div class="product-tagline">
            Blends into dark coats while still glowing when the lamp is on.
          </div>
          <div class="product-footer">
            <span class="price">From £31</span>
            <span>Night-time favourite</span>
          </div>
        </div>

        <!-- Frost Mint -->
        <div class="product-card">
          <div
            class="mini-bear"
            style="background:#a6e3c3;"
          >
            <div
              style="position:absolute;width:26px;height:26px;border-radius:50%;background:#a6e3c3;left:4px;top:-14px;"
            ></div>
            <div
              style="position:absolute;width:26px;height:26px;border-radius:50%;background:#a6e3c3;right:4px;top:-14px;"
            ></div>
            <div class="mini-face">
              <span class="eye"></span><span class="eye"></span>
              <div class="nose"></div>
            </div>
            <div class="mini-btn"></div>
          </div>
          <div class="product-name">Frost Mint</div>
          <div class="product-meta">
            <span class="swatch" style="background:#a6e3c3;"></span>
            Fresh &amp; playful
          </div>
          <div class="product-tagline">
            A brighter option for students who love cute, pastel accessories.
          </div>
          <div class="product-footer">
            <span class="price">From £30</span>
            <span>Perfect as a gift</span>
          </div>
        </div>
      </div>
    </section>

    <footer>
      <span>© 2025 Eliya – Concept website for student project.</span>
      <span>Questions? <a href="#">Contact the Eliya campus team</a></span>
    </footer>
  </div>

  <script>
    // simple front-end validation for the demo form
    document.getElementById("eliya-form").addEventListener("submit", function (e) {
      e.preventDefault();
      const name = document.getElementById("name").value.trim();
      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value.trim();
      const code = document.getElementById("code").value.trim();

      if (!name || !email || !password || !code) {
        alert("Please fill in all fields, including your Eliya Code.");
        return;
      }

      if (password.length < 8) {
        alert("Password should be at least 8 characters.");
        return;
      }

      if (!/^[A-Za-z0-9]{6,16}$/.test(code)) {
        alert("Please enter a valid Eliya Code (6–16 letters or numbers).");
        return;
      }

      alert(
        "Thank you, " +
          name +
          "! Your Eliya Winter Night Companion early access request has been recorded. (Demo only)"
      );
      this.reset();
    });
  </script>
</body>
</html>
